# ============================================================================
# HealAssi 백엔드 환경설정
# 
# 주의: 이 파일은 예시입니다. 실제로는 .env 파일을 만들고 Git에 올리지 마세요!
# production 환경에서는 실제 강력한 값들로 설정하십시오.
# ============================================================================

# JWT 토큰 설정
# SECRET_KEY는 생산 환경에서 매우 안전한 값으로 변경해야 합니다.
# OpenSSL을 사용해 생성: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-this-in-production-use-openssl-rand-hex-32

# JWT 알고리즘 (변경 금지)
ALGORITHM=HS256

# 액세스 토큰 유효기간 (분 단위)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 리프레시 토큰 유효기간 (일 단위)
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# 데이터베이스 설정
# ============================================================================

# 로컬 개발 (SQLite)
DATABASE_URL=sqlite:///./health.db

# Railway 배포 (PostgreSQL)
# DATABASE_URL=postgresql://username:password@host:port/database_name

# ============================================================================
# API 설정
# ============================================================================

# 프로젝트 이름
PROJECT_NAME=HealAssi API

# API 버전 경로
API_V1_STR=/api/v1

